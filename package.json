{
  "name": "personal-knowledge-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs && vitest run",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "deploy": "node scripts/deploy-pkw.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "preview": "node scripts/build.mjs && node scripts/verify-packed.mjs --preview",
    "serve:collaboration": "node scripts/serve-collaboration.mjs",
    "data": "node scripts/pkw-data.mjs",
    "evaluate:retrieval": "node scripts/evaluate-retrieval.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
