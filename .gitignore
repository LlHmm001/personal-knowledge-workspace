.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.*.yaml
config.yaml
!config.example.yaml

# ── editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
