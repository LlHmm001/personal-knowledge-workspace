{
  // Resolution facade for vite-tsconfig-paths (vitest) and tsc. The harness
  // checkout is resolved through `baseUrl` + `paths`; PKW's own packages are
  // repo-relative so `baseUrl` does not shadow them and the repo stays portable.
  //
  // Path portability: PKW's own packages are repo-relative (baseUrl "."). The
  // harness seam is pinned to the single well-known symlink
  // `/opt/deepseek-harness` (the deployment keeps it pointing at the active
  // release under /opt/dsh-releases/). Do NOT rewrite it to a sibling
  // "../deepseek-harness" (that layout does not exist here) or to a versioned
  // "/opt/dsh-releases/v-*" path (that churns on every upgrade).
  // NEVER add include/files here (vite-tsconfig-paths treats no-include as match-all).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["/opt/deepseek-harness/vendor/cordis/src"],
      "@deepseek-ai/cosmokit": ["/opt/deepseek-harness/vendor/cosmokit/src"],
      "@deepseek-ai/schemastery": ["/opt/deepseek-harness/vendor/schemastery/src"],
      "@deepseek-ai/cordis-plugin-timer": ["/opt/deepseek-harness/vendor/timer/src"],
      "@deepseek-ai/dsh-host-webserver": ["/opt/deepseek-harness/packages/host/webserver/src"],
      "@deepseek-ai/dsh-invariants": ["/opt/deepseek-harness/packages/runtime-diagnostics/invariants/src/index.ts"],
      "@deepseek-ai/dsh-pkw-domain": ["packages/pkw/domain/src"],
      "@deepseek-ai/dsh-pkw-events": ["packages/pkw/events/src"],
      "@deepseek-ai/dsh-pkw-workspace": ["packages/pkw/workspace/src"],
      "@deepseek-ai/dsh-pkw-notes": ["packages/pkw/notes/src"],
      "@deepseek-ai/dsh-pkw-attachments": ["packages/pkw/attachments/src"],
      "@deepseek-ai/dsh-pkw-weknora": ["packages/pkw/weknora/src"],
      "@deepseek-ai/dsh-pkw-weknora-sync": ["packages/pkw/weknora-sync/src"],
      "@deepseek-ai/dsh-pkw-web": ["packages/pkw/web/src"],
      "@deepseek-ai/dsh-pkw-tasks": ["packages/pkw/tasks/src"],
      "@deepseek-ai/dsh-*": [
        "/opt/deepseek-harness/packages/core/*/src",
        "/opt/deepseek-harness/packages/llm/*/src",
        "/opt/deepseek-harness/packages/shell/*/src",
        "/opt/deepseek-harness/packages/terminal/*/src",
        "/opt/deepseek-harness/packages/subprocess/*/src",
        "/opt/deepseek-harness/packages/e2b/*/src",
        "/opt/deepseek-harness/packages/code-runtime/*/src",
        "/opt/deepseek-harness/packages/fs/*/src",
        "/opt/deepseek-harness/packages/lsp/*/src",
        "/opt/deepseek-harness/packages/skill/*/src",
        "/opt/deepseek-harness/packages/compaction/*/src",
        "/opt/deepseek-harness/packages/context/*/src",
        "/opt/deepseek-harness/packages/goal/*/src",
        "/opt/deepseek-harness/packages/feedback/*/src",
        "/opt/deepseek-harness/packages/schedule/*/src",
        "/opt/deepseek-harness/packages/guard/*/src",
        "/opt/deepseek-harness/packages/plan/*/src",
        "/opt/deepseek-harness/packages/preset/*/src",
        "/opt/deepseek-harness/packages/subagent/*/src",
        "/opt/deepseek-harness/packages/jobs/*/src",
        "/opt/deepseek-harness/packages/workflow/*/src",
        "/opt/deepseek-harness/packages/web/*/src",
        "/opt/deepseek-harness/packages/attachment/*/src",
        "/opt/deepseek-harness/packages/spill/*/src",
        "/opt/deepseek-harness/packages/todo/*/src",
        "/opt/deepseek-harness/packages/bundle/*/src",
        "/opt/deepseek-harness/packages/extensions/*/src",
        "/opt/deepseek-harness/packages/sandbox/*/src",
        "/opt/deepseek-harness/packages/hooks/*/src",
        "/opt/deepseek-harness/packages/session/*/src",
        "/opt/deepseek-harness/packages/session-query/*/src",
        "/opt/deepseek-harness/packages/settings/*/src",
        "/opt/deepseek-harness/packages/credentials/*/src",
        "/opt/deepseek-harness/packages/acp/*/src",
        "/opt/deepseek-harness/packages/storage/*/src",
        "/opt/deepseek-harness/packages/workspace/*/src",
        "/opt/deepseek-harness/packages/sdk/*/src",
        "/opt/deepseek-harness/packages/interaction/*/src",
        "/opt/deepseek-harness/packages/boot/*/src",
        "/opt/deepseek-harness/packages/examples/*/src",
        "/opt/deepseek-harness/packages/util/*/src",
        "/opt/deepseek-harness/packages/mcp/*/src",
        "/opt/deepseek-harness/packages/identity/*/src",
        "/opt/deepseek-harness/packages/test-support/*/src",
        "/opt/deepseek-harness/packages/host/*/src",
        "/opt/deepseek-harness/packages/client/*/src"
      ]
    }
  }
}
